# Receiver
DENON_HOST=192.168.2.8
DENON_PORT=23
# Denon protocol input token, not the UI label. MEDIA PLAYER = MPLAY.
DENON_SHIELD_INPUT=MPLAY
AUTOTUNE_MEASUREMENT_VOLUME_DB=-30

# Writes are OFF by default. Set to 1 only after validating read-only preflight and hardware gates.
ALLOW_RECEIVER_WRITES=0

# EvoBurrow MCP, built server entrypoint
EVOBURROW_SERVER=/absolute/path/to/evoburrow-mcp/dist/server.mjs
A1_EVO_HOME=/absolute/path/to/a1-evo-workspace

# NVIDIA Shield
SHIELD_HOST=192.168.2.x
ADB_PATH=adb
SHIELD_SWEEP_DIR=/sdcard/Movies/AtmosCalibration
SHIELD_PLAYER_COMPONENT=

# REW
REW_URL=http://127.0.0.1:4735
REW_MEASUREMENT_MODE=auto
REW_FILE_PLAYBACK_ARM_DELAY_MS=4000

# A1/Nexus handoff
NEXUS_WORKSPACE=/absolute/path/to/nexus-workspace
NEXUS_COMMAND=

# V2 dashboard and deterministic profile
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3700
CALIBRATION_PROFILE=./profiles/reference-home-theater.json
# probe keeps Denon-native post-correction measurement disabled until hardware evidence proves it.
DENON_NATIVE_MEASUREMENT=probe

# Local artifacts
SESSIONS_DIR=./sessions
